{
  "name": "rowake-web",
  "private": true,
  "scripts": {
    "build:web": "esbuild webembed/src/app.js --bundle --format=iife --platform=browser --target=es2022 --minify-whitespace --legal-comments=eof --outfile=webembed/dist/app.js",
    "check:web": "npm run build:web -- --log-level=warning && node --check webembed/dist/app.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@lezer/highlight": "1.2.3",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
